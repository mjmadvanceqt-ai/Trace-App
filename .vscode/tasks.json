{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install Capacitor Android tooling",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"install",
				"@capacitor/core",
				"@capacitor/android",
				"@capacitor/cli",
				"--save"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Create Android project",
			"type": "shell",
			"command": "npx.cmd",
			"args": [
				"cap",
				"add",
				"android"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Repair dependencies",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"ci"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify dependency repair",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"exec",
				"--",
				"node",
				"-e",
				"console.log(require.resolve('stream-buffers'))"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify dependency repair",
			"type": "shell",
			"command": "node",
			"args": [
				"-p",
				"require.resolve('stream-buffers')"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check repaired module",
			"type": "shell",
			"command": "node",
			"args": [
				"-p",
				"\"require.resolve('stream-buffers')\""
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Generate Capacitor Android project",
			"type": "shell",
			"command": "npx.cmd",
			"args": [
				"cap",
				"add",
				"android"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install Capacitor packages completely",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"install",
				"--ignore-scripts"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify Capacitor CLI files",
			"type": "shell",
			"command": "Get-ChildItem",
			"args": [
				"node_modules\\@capacitor\\cli"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect Capacitor CLI package",
			"type": "shell",
			"command": "Get-Content",
			"args": [
				"node_modules\\@capacitor\\cli\\package.json"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Complete npm dependency install",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"npm.cmd install --ignore-scripts"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check Capacitor installation state",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"if exist node_modules\\@capacitor\\cli\\package.json (echo CLI_READY) else (echo CLI_MISSING)"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check npm processes",
			"type": "shell",
			"command": "Get-Process",
			"args": [
				"node,npm"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Clear stale Node processes",
			"type": "shell",
			"command": "Get-Process",
			"args": [
				"node",
				"-ErrorAction",
				"SilentlyContinue",
				"|",
				"Stop-Process",
				"-Force"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install Capacitor cleanly",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"npm.cmd install @capacitor/core@8.5.2 @capacitor/android@8.5.2 @capacitor/cli@8.5.2 --save"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify Capacitor CLI",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"if exist node_modules\\@capacitor\\cli\\package.json (echo CLI_READY) else (echo CLI_MISSING)"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Generate Android project",
			"type": "shell",
			"command": "npx.cmd",
			"args": [
				"cap",
				"add",
				"android"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect Capacitor executable",
			"type": "shell",
			"command": "Get-Content",
			"args": [
				"node_modules\\@capacitor\\cli\\package.json"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check Capacitor command shim",
			"type": "shell",
			"command": "Get-ChildItem",
			"args": [
				"node_modules\\.bin\\cap*"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Generate Android project directly",
			"type": "shell",
			"command": "node",
			"args": [
				"node_modules\\@capacitor\\cli\\bin\\capacitor",
				"add",
				"android"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Remove corrupted dependencies",
			"type": "shell",
			"command": "Remove-Item",
			"args": [
				"-Recurse",
				"-Force",
				"node_modules"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Force clean dependencies",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"rmdir /s /q node_modules"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Repair missing Capacitor dependencies",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"install",
				"@ionic/utils-fs@3.1.0",
				"fs-extra@11.2.0",
				"stream-buffers@3.0.2",
				"--force"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check native dependency files",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"if exist node_modules\\@ionic\\utils-fs\\node_modules\\fs-extra\\lib\\index.js (echo FS_EXTRA_READY) else (echo FS_EXTRA_MISSING) & if exist node_modules\\@capacitor\\cli\\dist\\index.js (echo CAP_READY) else (echo CAP_MISSING)"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Finish dependency installation",
			"type": "shell",
			"command": "$p = Start-Process",
			"args": [
				"npm.cmd",
				"-ArgumentList",
				"install @capacitor/core@8.5.2 @capacitor/android@8.5.2 @capacitor/cli@8.5.2 --force",
				"-Wait",
				"-PassThru",
				"-NoNewWindow",
				";",
				"Write-Output",
				"(\"NPM_EXIT=\" + $p.ExitCode)",
				";",
				"if (Test-Path \"node_modules\\@capacitor\\cli\\package.json\") { Write-Output \"CAPACITOR_READY\" } else { Write-Output \"CAPACITOR_MISSING\" }"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Finish dependency installation",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"$p = Start-Process npm.cmd -ArgumentList 'install @capacitor/core@8.5.2 @capacitor/android@8.5.2 @capacitor/cli@8.5.2 --force' -Wait -PassThru -NoNewWindow; Write-Output ('NPM_EXIT=' + $p.ExitCode); if (Test-Path 'node_modules\\@capacitor\\cli\\package.json') { Write-Output 'CAPACITOR_READY' } else { Write-Output 'CAPACITOR_MISSING' }"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run blocking Capacitor install",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"scripts\\install-capacitor.ps1"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check Capacitor install completion",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"if exist node_modules\\@capacitor\\cli\\package.json (echo CAPACITOR_READY) else (echo CAPACITOR_MISSING) & if exist node_modules\\@ionic\\utils-fs\\node_modules\\fs-extra\\lib\\index.js (echo FS_EXTRA_READY) else (echo FS_EXTRA_MISSING)"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check install processes",
			"type": "shell",
			"command": "Get-Process",
			"args": [
				"npm,node,powershell",
				"-ErrorAction",
				"SilentlyContinue"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check Capacitor install completion",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"if exist node_modules\\@capacitor\\cli\\package.json (echo CAPACITOR_READY) else (echo CAPACITOR_MISSING) & if exist node_modules\\@ionic\\utils-fs\\node_modules\\fs-extra\\lib\\index.js (echo FS_EXTRA_READY) else (echo FS_EXTRA_MISSING)"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check package install markers",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"dir /b node_modules\\@capacitor\\cli\\package.json node_modules\\@ionic\\utils-fs\\node_modules\\fs-extra\\lib\\index.js 2>nul"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stop stale npm workers",
			"type": "shell",
			"command": "Get-Process npm -ErrorAction SilentlyContinue | Stop-Process -Force",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Remove node modules cleanly",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"rmdir /s /q node_modules"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Clean install all dependencies",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"npm.cmd",
				"ci"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check clean install completion",
			"type": "shell",
			"command": "Get-Process npm,node -ErrorAction SilentlyContinue | Select-Object Name,Id,CPU",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check clean install files",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"if exist node_modules\\@capacitor\\cli\\package.json (echo CLI_READY) else (echo CLI_MISSING)"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check clean install status",
			"type": "shell",
			"command": "Get-Process node -ErrorAction SilentlyContinue | Select-Object Name,Id,CPU,StartTime",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check clean install status",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"if exist node_modules\\.package-lock.json (echo INSTALL_LOCK_READY) else (echo INSTALL_RUNNING)"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect install lock unique",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"if exist node_modules\\.package-lock.json (echo INSTALL_LOCK_READY) else (echo INSTALL_RUNNING)"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect install process unique",
			"type": "shell",
			"command": "Get-Process node -ErrorAction SilentlyContinue | Select-Object Id,CPU,Responding,StartTime",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect install package count",
			"type": "shell",
			"command": "(Get-ChildItem node_modules -Force -ErrorAction SilentlyContinue | Measure-Object).Count",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify install finished unique",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"if exist node_modules\\.package-lock.json (echo LOCK_READY) else (echo LOCK_PENDING) & if exist node_modules\\@capacitor\\cli\\package.json (echo CAP_READY) else (echo CAP_PENDING) & if exist node_modules\\@ionic\\utils-fs\\node_modules\\fs-extra\\lib\\index.js (echo NESTED_FS_READY) else (echo NESTED_FS_PENDING)"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect npm cache logs unique",
			"type": "shell",
			"command": "Get-ChildItem \"$env:LOCALAPPDATA\\npm-cache\\_logs\" -File | Sort-Object LastWriteTime | Select-Object -Last 3 Name,Length,LastWriteTime",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect active Node command unique",
			"type": "shell",
			"command": "Get-CimInstance Win32_Process -Filter \"ProcessId=15444\" | Select-Object ProcessId,CommandLine",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect active Node command full",
			"type": "shell",
			"command": "(Get-CimInstance Win32_Process -Filter \"ProcessId=15444\").CommandLine",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check npm install log unique",
			"type": "shell",
			"command": "Get-Content \"$env:LOCALAPPDATA\\npm-cache\\_logs\\2026-09-16T00_28_36_786Z-debug-0.log\" -Tail 20",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check npm install progress unique",
			"type": "shell",
			"command": "Get-Content \"$env:LOCALAPPDATA\\npm-cache\\_logs\\2026-09-16T00_28_36_786Z-debug-0.log\" -Tail 8",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check npm process after registry fetch unique",
			"type": "shell",
			"command": "Get-Process node -ErrorAction SilentlyContinue | Select-Object Id,CPU,Responding,StartTime",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check npm log timestamp unique",
			"type": "shell",
			"command": "Get-Item \"$env:LOCALAPPDATA\\npm-cache\\_logs\\2026-09-16T00_28_36_786Z-debug-0.log\" | Select-Object Length,LastWriteTime",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check npm log tail later unique",
			"type": "shell",
			"command": "Get-Content \"$env:LOCALAPPDATA\\npm-cache\\_logs\\2026-09-16T00_28_36_786Z-debug-0.log\" -Tail 12",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check npm registry progress unique",
			"type": "shell",
			"command": "Get-Item \"$env:LOCALAPPDATA\\npm-cache\\_logs\\2026-09-16T00_28_36_786Z-debug-0.log\" | Select-Object Length,LastWriteTime; Get-Process node -ErrorAction SilentlyContinue | Select-Object Id,CPU,Responding",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify clean install completed unique",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"if exist node_modules\\.package-lock.json (echo LOCK_READY) else (echo LOCK_MISSING) & if exist node_modules\\@capacitor\\cli\\package.json (echo CAP_READY) else (echo CAP_MISSING) & if exist node_modules\\@ionic\\utils-fs\\node_modules\\fs-extra\\lib\\index.js (echo NESTED_FS_READY) else (echo NESTED_FS_MISSING)"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Read clean install result unique",
			"type": "shell",
			"command": "Get-Content \"$env:LOCALAPPDATA\\npm-cache\\_logs\\2026-09-16T00_28_36_786Z-debug-0.log\" -Tail 40",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install missing Capacitor packages unique",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"npm.cmd install --no-audit --no-fund --ignore-scripts @capacitor/core@8.5.2 @capacitor/android@8.5.2 @capacitor/cli@8.5.2"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check Capacitor install progress unique",
			"type": "shell",
			"command": "Get-Process node -ErrorAction SilentlyContinue | Select-Object Id,CPU,Responding; if (Test-Path 'node_modules\\@capacitor\\cli\\package.json') { 'CAP_READY' } else { 'CAP_PENDING' }",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect npm processes unique",
			"type": "shell",
			"command": "Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'node.exe' } | Select-Object ProcessId,CommandLine",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect npm process commands unique",
			"type": "shell",
			"command": "Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'node.exe' } | ForEach-Object { $_.CommandLine }",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stop stale npm ci only",
			"type": "shell",
			"command": "Stop-Process -Id 15444 -Force",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify Capacitor install after cleanup unique",
			"type": "shell",
			"command": "Get-Process node -ErrorAction SilentlyContinue | Select-Object Id,CPU; if (Test-Path 'node_modules\\@capacitor\\cli\\package.json') { 'CAP_READY' } else { 'CAP_PENDING' }; if (Test-Path 'node_modules\\@ionic\\utils-fs\\node_modules\\fs-extra\\lib\\index.js') { 'FS_READY' } else { 'FS_PENDING' }",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Confirm npm workers unique",
			"type": "shell",
			"command": "Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'node.exe' } | Select-Object ProcessId,CommandLine",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Confirm npm worker commands unique",
			"type": "shell",
			"command": "Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'node.exe' } | ForEach-Object { Write-Output ($_.ProcessId.ToString() + ' ' + $_.CommandLine) }",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Generate Android project final",
			"type": "shell",
			"command": "node",
			"args": [
				"node_modules\\@capacitor\\cli\\bin\\capacitor",
				"add",
				"android"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install Capacitor CLI runtime dependency",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
