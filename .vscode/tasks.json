			"type": "shell",
			"command": "Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'node.exe' -and $_.CommandLine -match 'npm-cli.js' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install all native runtime packages single",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"npm.cmd",
				"install",
				"--no-audit",
				"--no-fund",
				"--ignore-scripts",
				"@capacitor/core@8.5.2",
				"@capacitor/android@8.5.2",
				"@capacitor/cli@8.5.2",
				"rimraf@6.0.1"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Generate Android project clean",
			"type": "shell",
			"command": "node",
			"args": [
				"node_modules\\@capacitor\\cli\\bin\\capacitor",
				"add",
				"android"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "List generated assets",
			"type": "shell",
			"command": "Get-ChildItem",
			"args": [
				".vercel\\output\\static\\assets"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Identify client entry assets",
			"type": "shell",
			"command": "Get-ChildItem",
			"args": [
				".vercel\\output\\static\\assets",
